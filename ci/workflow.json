{
  "package": "conduit",
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-macos",
    "aarch64-macos",
    "x86_64-windows-gnu",
    "x86_64-windows-msvc",
    "aarch64-windows-gnu",
    "x86_64-freebsd",
    "x86_64-netbsd"
  ],
  "compile_once": false,
  "test_timeout": "--test-timeout 45s",
  "sanitizer": "unit",
  "before_tests_step": "check-runner"
}
