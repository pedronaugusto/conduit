{
  "land": true,
  "attest": true,
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-macos",
    "aarch64-macos",
    "x86_64-windows-gnu",
    "x86_64-windows-msvc",
    "aarch64-windows-gnu",
    "x86_64-freebsd",
    "x86_64-netbsd"
  ],
  "compile_once": false,
  "before_tests_step": "check-runner",
  "jobs": [
    {
      "name": "ThreadSanitizer (Linux)",
      "step": "unit",
      "args": ["-Dthread-sanitizer=true", "-Doptimize=debug", "-Dci-lint=false"],
      "tiers": ["release"]
    }
  ]
}
